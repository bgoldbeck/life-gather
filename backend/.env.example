LIFEGATHER_APP_NAME=LifeGather
# Private data must remain outside the frontend static directory.
LIFEGATHER_DATA_DIR=data
LIFEGATHER_PUBLIC_URL=http://127.0.0.1:8787
LIFEGATHER_GOOGLE_CLIENT_ID=
LIFEGATHER_GOOGLE_CLIENT_SECRET=
