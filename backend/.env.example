LIFEGATHER_APP_NAME=LifeGather
# Private data must remain outside the frontend static directory.
LIFEGATHER_DATA_DIR=data
LIFEGATHER_PUBLIC_URL=http://127.0.0.1:8787
LIFEGATHER_GOOGLE_CLIENT_ID=
LIFEGATHER_GOOGLE_CLIENT_SECRET=
# Optional: 32-byte vault key outside data/static directories. See docs/PRIVATE_SETTINGS.md.
# LIFEGATHER_VAULT_KEY_FILE=D:/lifegather-secrets/vault.key
# Set after building the frontend to serve the app from the backend:
# LIFEGATHER_STATIC_DIR=../frontend/dist
