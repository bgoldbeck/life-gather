FROM python:3.13-slim-bookworm AS tests
COPY --from=ghcr.io/astral-sh/uv:0.13.0 /uv /uvx /bin/
ENV UV_LINK_MODE=copy PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app/backend
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --locked --no-install-project --extra s3
COPY backend/src ./src
RUN uv sync --locked --no-editable --extra s3 --reinstall-package lifegather-backend
COPY backend/tests ./tests
COPY README.md /app/README.md
COPY deploy/cloudflare/container-settings.json /app/deploy/cloudflare/container-settings.json
COPY scripts/backend_test_shard.py /runner/backend_test_shard.py
RUN groupadd --gid 10001 tests && useradd --uid 10001 --gid 10001 --no-create-home tests
USER 10001:10001
ENTRYPOINT ["/app/backend/.venv/bin/python", "/runner/backend_test_shard.py"]
ARG TEST_INPUTS
LABEL lifegather.test-inputs=$TEST_INPUTS

# Match the publisher's base dev environment for strict optional-import typing.
# The full suite above retains S3 coverage; removing extras needs no downloads.
FROM tests AS checks
USER root
RUN uv sync --locked --offline --no-editable
USER 10001:10001

FROM tests AS release-tests
