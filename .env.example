# Optional Docker Compose configuration. Copy to .env at the repository root.
# Published only on 127.0.0.1; do not expose remotely before authentication exists.
LIFEGATHER_PORT=8787
LIFEGATHER_PUBLIC_URL=http://127.0.0.1:8787
LIFEGATHER_GOOGLE_CLIENT_ID=
LIFEGATHER_GOOGLE_CLIENT_SECRET=
LIFEGATHER_APP_NAME=LifeGather

# Local testing only: exposes a shared test workspace without a password.
LIFEGATHER_TEST_LOGIN_ENABLED=false

# Optional installation-wide email verification/recovery sender. All four identity
# values must be configured together. No SMTP connection is made until sending.
LIFEGATHER_SMTP_HOST=
LIFEGATHER_SMTP_PORT=587
LIFEGATHER_SMTP_USERNAME=
LIFEGATHER_SMTP_PASSWORD=
LIFEGATHER_SMTP_SENDER=
# false = required STARTTLS; true = implicit TLS (usually port 465).
LIFEGATHER_SMTP_IMPLICIT_TLS=false
