# LifeGather test site settings. `npm run init-settings` copies this file to
# test-site.env with fresh VAULT_KEYS and JOB_TICK_TOKEN. Fill in the rest, then
# run `npm run push-settings`. test-site.env is ignored by Git: never commit it.
# Steps: docs/CLOUDFLARE_TEST_SITE.md

# Required -------------------------------------------------------------------
# The Worker's address, shown by `npm run deploy`, with no trailing slash.
PUBLIC_URL=https://lifegather-test.YOUR-SUBDOMAIN.workers.dev
# Neon (or other PostgreSQL) direct connection string, not the "pooled" one.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/lifegather?sslmode=require
# Encrypts saved AI keys and Gmail sign-ins. New for the test site; never your home key.
VAULT_KEYS=
# Lets the Cron Trigger run scheduled scans.
JOB_TICK_TOKEN=
# Proves to the app that the Worker set the visitor's address, so sign-in
# limits count each visitor separately. Any 32+ character random value.
PROXY_SECRET=
# Private R2 bucket for photos and documents, and an R2 API token for it.
R2_BUCKET=lifegather-test-files
R2_ENDPOINT_URL=https://ACCOUNT-ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Cloudflare Access application for this Worker (Zero Trust > Access > Applications).
ACCESS_TEAM_DOMAIN=YOUR-TEAM.cloudflareaccess.com
ACCESS_AUD=

# Optional -------------------------------------------------------------------
APP_NAME=LifeGather Test
# Google sign-in and Gmail: add PUBLIC_URL/auth/google/callback to the OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email sign-up and password reset need all four SMTP values.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
SMTP_IMPLICIT_TLS=false
